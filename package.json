{
  "name": "naqsha",
  "version": "0.0.0",
  "private": true,
  "description": "Browser app that reads Jacquard loom punch cards, rebuilds the weave pattern, simulates the cloth and exports a bitmap for electronic Jacquard looms.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reallyishan009/naqsha.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build_precache.ts",
    "preview": "vite preview",
    "check-bundle": "node scripts/check_bundle.ts",
    "check:all": "node scripts/check_all.ts",
    "check:browser": "node scripts/check_browser.ts",
    "check:deployed": "node scripts/check_deployed.ts",
    "check:manual": "node scripts/check_manual.ts",
    "check:everything": "node scripts/check_everything.ts",
    "check:hooks": "node scripts/check_hooks.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:loom-mcp": "npm --prefix tools/loom-mcp run typecheck",
    "test:loom-mcp": "npm --prefix tools/loom-mcp test",
    "fixtures": "node scripts/make_fixtures.ts --all",
    "sample-cloth": "node scripts/render_sample.ts",
    "sample-bmp": "node scripts/export_sample.ts",
    "review-list": "node scripts/review_list.ts",
    "icons": "node scripts/make_icons.ts",
    "make-art": "node scripts/make_art.ts",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
